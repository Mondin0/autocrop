AUTOCROP_IMAGE=mondin0/autocrop:0.1.0
AUTOCROP_UID=1000
AUTOCROP_GID=1000
# CLI V1: carpetas del host montadas como /input (solo lectura) y /output.
AUTOCROP_INPUT_DIR=./fotos
AUTOCROP_OUTPUT_DIR=./output
# Demo local V2 (etapa V2-04): la API escucha solo en localhost.
AUTOCROP_API_PORT=8000
# Interfaz web V2-05: el frontend escucha solo en localhost y proxifica /api.
AUTOCROP_FRONTEND_PORT=8080
AUTOCROP_REDIS_URL=redis://redis:6379/0
AUTOCROP_S3_ENDPOINT=http://rustfs:9000
AUTOCROP_S3_BUCKET=autocrop
AUTOCROP_S3_ACCESS_KEY=autocrop-local
# Demo local: no es un secreto real. Cambiarla si RustFS deja de ser
# inaccesible desde fuera del host (Compose no publica sus puertos).
AUTOCROP_S3_SECRET_KEY=autocrop-local-secret-01
